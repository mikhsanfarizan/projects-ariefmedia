<div id="hydration-data" data="<%= JSON.stringify(product); %>"></div>
<section class="detail-section">
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Home</a> &gt;
      <span id="breadcrumb-category"><%= product?.categories %></span> &gt;
      <span id="breadcrumb-title" class="active-crumb"><%= product?.product_name; %></span>
    </div>

    <div class="detail-grid">
      <div class="detail-gallery-wrapper">
        <div class="main-media-display">
          <button id="btn-zoom" class="btn-zoom" title="Zoom Gambar">
            <i class="fas fa-search-minus"></i>
          </button>

          <img
            id="main-image"
            src="/<%= product?.featured_image %>"
            alt="Pemesanan <%= product?.product_name %>"
            class="media-content active"
          />
          <iframe
            id="main-video"
            class="media-content"
            src=""
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>

        <div class="thumbnail-container" id="thumbnail-container"></div>
      </div>

      <div class="detail-info">
        <h1 id="product-title" class="detail-title"><%= product?.product_name %></h1>

        <a id="wa-button" href="#" target="_blank" class="btn-whatsapp">
          <i class="fab fa-whatsapp"></i> PESAN SEKARANG
        </a>

        <div class="product-meta">
          <p><strong>Category:</strong> <span id="product-category"><%= product?.categories %></span></p>
          <p><strong>Tags:</strong> <span id="product-tags"><%= product?.tags %></span></p>
        </div>

        <div class="product-description-content">
          <h3><i class="fas fa-pencil-alt"></i> Deskripsi</h3>
          <div id="product-description"><%- product?.description %></div>
        </div>
      </div>
    </div>
  </div>
</section>

<div id="lightbox-modal" class="lightbox">
  <span class="close-lightbox">&times;</span>
  <img class="lightbox-content" id="lightbox-img" />
</div>
